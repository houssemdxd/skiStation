{
  "info": {
    "name": "Ski Station API",
    "description": "All REST routes for Piste, Cours, Moniteur, Skieur, Abonnement and Inscription.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "numPiste",
      "value": "1"
    },
    {
      "key": "numCours",
      "value": "1"
    },
    {
      "key": "numMoniteur",
      "value": "1"
    },
    {
      "key": "numSkieur",
      "value": "1"
    },
    {
      "key": "numInscription",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Piste",
      "item": [
        {
          "name": "Get all pistes",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/piste/all"
          }
        },
        {
          "name": "Get piste by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/piste/{{numPiste}}"
          }
        },
        {
          "name": "Add piste",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nomPiste\": \"La Verte\",\n  \"color\": \"VERT\",\n  \"Longeur\": 3,\n  \"pente\": 15\n}"
            },
            "url": "{{baseUrl}}/piste/add"
          }
        },
        {
          "name": "Update piste",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numPiste\": 1,\n  \"nomPiste\": \"La Verte\",\n  \"color\": \"BLEU\",\n  \"Longeur\": 4,\n  \"pente\": 20\n}"
            },
            "url": "{{baseUrl}}/piste/update"
          }
        },
        {
          "name": "Delete piste",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/piste/{{numPiste}}"
          }
        }
      ]
    },
    {
      "name": "Cours",
      "item": [
        {
          "name": "Get all courses",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/cours/all"
          }
        },
        {
          "name": "Get cours by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/cours/{{numCours}}"
          }
        },
        {
          "name": "Add cours",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"niveau\": 1,\n  \"typeCours\": \"COLLECTIF_ADULTE\",\n  \"support\": \"SKI\",\n  \"prix\": 120.5,\n  \"creanau\": 1\n}"
            },
            "url": "{{baseUrl}}/cours/add"
          }
        },
        {
          "name": "Add cours with moniteur",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"niveau\": 2,\n  \"typeCours\": \"PARTICULEIR\",\n  \"support\": \"SNOWBOARD\",\n  \"prix\": 200,\n  \"creanau\": 2,\n  \"moniteur\": {\n    \"numMoniteur\": 1\n  }\n}"
            },
            "url": "{{baseUrl}}/cours/add"
          }
        },
        {
          "name": "Update cours",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numCours\": 1,\n  \"niveau\": 2,\n  \"typeCours\": \"COLLECTIF_ENFANT\",\n  \"support\": \"SKI\",\n  \"prix\": 90,\n  \"creanau\": 1\n}"
            },
            "url": "{{baseUrl}}/cours/update"
          }
        },
        {
          "name": "Delete cours",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/cours/{{numCours}}"
          }
        },
        {
          "name": "Get cours by type",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/cours/byType/COLLECTIF_ADULTE"
          }
        },
        {
          "name": "Get cours by support",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/cours/bySupport/SKI"
          }
        }
      ]
    },
    {
      "name": "Moniteur",
      "item": [
        {
          "name": "Get all moniteurs",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/moniteur/all"
          }
        },
        {
          "name": "Get moniteur by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/moniteur/{{numMoniteur}}"
          }
        },
        {
          "name": "Add moniteur",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nomM\": \"Dupont\",\n  \"prenomM\": \"Jean\",\n  \"dateRecus\": \"2020-01-15\"\n}"
            },
            "url": "{{baseUrl}}/moniteur/add"
          }
        },
        {
          "name": "Update moniteur",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numMoniteur\": 1,\n  \"nomM\": \"Dupont\",\n  \"prenomM\": \"Jean-Pierre\",\n  \"dateRecus\": \"2020-01-15\",\n  \"prime\": 0\n}"
            },
            "url": "{{baseUrl}}/moniteur/update"
          }
        },
        {
          "name": "Add moniteur and assign to cours",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nomM\": \"Bernard\",\n  \"prenomM\": \"Luc\",\n  \"dateRecus\": \"2018-09-01\"\n}"
            },
            "url": "{{baseUrl}}/moniteur/addAndAssignToCours/{{numCours}}"
          }
        },
        {
          "name": "Weeks of moniteur by support",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/moniteur/weeks/{{numMoniteur}}/SKI"
          }
        },
        {
          "name": "Best moniteur (set prime)",
          "request": {
            "method": "PUT",
            "header": [],
            "url": "{{baseUrl}}/moniteur/best"
          }
        },
        {
          "name": "Delete moniteur",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/moniteur/{{numMoniteur}}"
          }
        }
      ]
    },
    {
      "name": "Skieur",
      "item": [
        {
          "name": "Get all skieurs",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/skieur/all"
          }
        },
        {
          "name": "Get skieur by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/skieur/{{numSkieur}}"
          }
        },
        {
          "name": "Add skieur with abonnement",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nomS\": \"Martin\",\n  \"prenomS\": \"Alice\",\n  \"dateNaissance\": \"1998-05-20\",\n  \"ville\": \"Grenoble\",\n  \"abonnement\": {\n    \"datedebut\": \"2026-01-01\",\n    \"dateFin\": \"2026-12-31\",\n    \"prixAbon\": 450,\n    \"typeAbonnement\": \"ANNUEL\"\n  }\n}"
            },
            "url": "{{baseUrl}}/skieur/add"
          }
        },
        {
          "name": "Update skieur",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numSkieur\": 1,\n  \"nomS\": \"Martin\",\n  \"prenomS\": \"Alice\",\n  \"dateNaissance\": \"1998-05-20\",\n  \"ville\": \"Annecy\"\n}"
            },
            "url": "{{baseUrl}}/skieur/update"
          }
        },
        {
          "name": "Delete skieur",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/skieur/{{numSkieur}}"
          }
        },
        {
          "name": "Assign skieur to piste",
          "request": {
            "method": "PUT",
            "header": [],
            "url": "{{baseUrl}}/skieur/assignToPiste/{{numSkieur}}/{{numPiste}}"
          }
        },
        {
          "name": "Add skieur and assign to cours",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nomS\": \"Durand\",\n  \"prenomS\": \"Paul\",\n  \"dateNaissance\": \"2005-03-12\",\n  \"ville\": \"Chamonix\",\n  \"abonnement\": {\n    \"datedebut\": \"2026-01-01\",\n    \"dateFin\": \"2026-03-31\",\n    \"prixAbon\": 180,\n    \"typeAbonnement\": \"SEMESTER\"\n  }\n}"
            },
            "url": "{{baseUrl}}/skieur/addAndAssignToCours/{{numCours}}"
          }
        },
        {
          "name": "Get skieurs by type abonnement",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/skieur/byTypeAbonnement/ANNUEL"
          }
        },
        {
          "name": "Nombre skieurs par couleur piste",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/skieur/nombreParCouleurPiste"
          }
        }
      ]
    },
    {
      "name": "Abonnement",
