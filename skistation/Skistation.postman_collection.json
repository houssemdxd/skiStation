                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 1,\n  \"datedebut\": \"2026-01-01\",\n  \"dateFin\": \"2026-01-31\",\n  \"prixAbon\": 89,\n  \"typeAbonnement\": \"MENSUELL\"\n}"
