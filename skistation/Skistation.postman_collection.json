        {
          "name": "Get abonnements by type",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/abonnement/byType/ANNUEL"
          }
        },
        {
          "name": "Get abonnements by dates",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/abonnement/byDates?startDate=2026-01-01&endDate=2026-12-31",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "abonnement",
                "byDates"
              ],
              "query": [
                {
                  "key": "startDate",
                  "value": "2026-01-01"
                },
                {
                  "key": "endDate",
                  "value": "2026-12-31"
                }
              ]
            }
          }
        }
      ]
    },
    {
